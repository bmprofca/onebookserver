# Server env — production (Hostinger Node app)
# Copy to `.env` on the server (or set the same keys in hPanel → Environment variables)
# Public API: https://onebookserver.onesaasbackend.com

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your-user
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=your-database

# Hostinger usually injects PORT — keep a fallback
PORT=4000

ONECHATTING_TOKEN=your_developer_token
ONECHATTING_OTP_TEMPLATE_ID=login_otp
ONECHATTING_PAYMENT_REMINDER_TEMPLATE_ID=payment_reminder
ONECHATTING_PAYMENT_REMINDER_PARAMS=name,amount,shop,team

FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=FSTSMS
FAST2SMS_OTP_ID=
FAST2SMS_OTP_MESSAGE_ID=
