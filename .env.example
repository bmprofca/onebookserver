# MySQL
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-user
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=your-database

# Server
PORT=4000

# OTP channels: whatsapp, sms (comma-separated). Uses whichever is configured.
# OTP_CHANNELS=whatsapp,sms
# OTP_DEMO_FALLBACK=1

# OneChatting WhatsApp (Meta Cloud API via BSP) — https://docs.onechatting.com/
ONECHATTING_TOKEN=your_developer_token
# Platform (OneSAAS-CRM) tokens — primary store is MySQL `platform_whatsapp_tokens`.
# Env values are fallback only; update via admin portal later.
# ONEBOOK_PLATFORM_DEVELOPER_TOKEN=
# ONEBOOK_PLATFORM_USER_TOKEN=
# Optional key for PUT/GET /api/admin/platform-whatsapp
# PLATFORM_ADMIN_API_KEY=
# Prefer the opaque template_id from OneChatting (not just the name).
# Name "login_otp" is resolved automatically, but the id is more reliable.
ONECHATTING_OTP_TEMPLATE_ID=login_otp
# Example id form: ONECHATTING_OTP_TEMPLATE_ID=a6zh31a81615122c4uyv3n12r46qzrv68l7a4qu0a8n
# Approved UTILITY template for auto payment reminders
# payment_reminder body: Dear {{1}}, Rs. {{2}} to {{3}}, Team {{4}}
ONECHATTING_PAYMENT_REMINDER_TEMPLATE_ID=payment_reminder
ONECHATTING_PAYMENT_REMINDER_PARAMS=name,amount,shop,team
# ONECHATTING_PAYMENT_REMINDER_TEAM=Bmtax
# ONECHATTING_PAYMENT_REMINDER_HEADER_IMAGE=https://example.com/header.jpg
# ONECHATTING_BASE_URL=https://server.onechatting.com
# ONECHATTING_COUNTRY_CODE=91

# Fast2SMS SMS / DLT templates (https://docs.fast2sms.com/reference/authorization)
# Include Authorization: YOUR_API_KEY on every request.
FAST2SMS_API_KEY=your_fast2sms_api_key
FAST2SMS_SENDER_ID=FSTSMS
# Option A — dedicated OTP API (/dev/otp/send)
FAST2SMS_OTP_ID=
# Option B — DLT template Message ID (/dev/bulkV2 route=dlt) for OTP + future templates
FAST2SMS_OTP_MESSAGE_ID=
# FAST2SMS_BASE_URL=https://www.fast2sms.com
# FAST2SMS_OTP_EXPIRY_MINUTES=5

# In-app update prompt (optional; also editable in server/data/app-version.json)
# When you release a new APK, bump latestVersionCode above the installed build.
# APP_LATEST_VERSION_CODE=4
# APP_LATEST_VERSION_NAME=1.3
# APP_MIN_VERSION_CODE=3
# APP_FORCE_UPDATE=0
# APP_UPDATE_URL=https://play.google.com/store/apps/details?id=com.transation.app
# APP_UPDATE_MESSAGE=New version ready — please update OneBook.

# Estimated INR cost per successful WhatsApp utility template (for Reports)
# WHATSAPP_MESSAGE_COST_INR=0.75

# In-house Meta WhatsApp Cloud API (shop Settings → WhatsApp API → Connect)
# META_WA_API_VERSION=v21.0
# META_WA_GRAPH_URL=https://graph.facebook.com
